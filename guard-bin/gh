#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/core.sh"
case "${1:-}" in
  --version|version|--help|help) exec "$SGH_REAL_GH" "$@";;
  auth)
    case "${2:-}" in
      login|logout|switch)
        echo '[sgh] 계정 등록/전환은 sgh add, sgh reauth, sgh swap 명령을 사용하세요.' >&2
        exit 72;;
    esac;;
esac
if [[ -n "${SGH_PINNED_PROFILE:-}" ]]; then
  sgh_apply "$SGH_PINNED_PROFILE"
else
  sgh_resolve
fi
exec "$SGH_REAL_GH" "$@"
