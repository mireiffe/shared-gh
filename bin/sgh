#!/usr/bin/env bash
# sgh: session-scoped GitHub profile switcher for shared Linux development users.
set -euo pipefail
_sgh_executable="$(readlink -f "${BASH_SOURCE[0]}")"
source "$(dirname "$_sgh_executable")/../lib/core.sh"
unset _sgh_executable

usage() {
  cat <<'HELP'
sgh — GitHub identity switcher (shared Linux account)

  sgh list                 저장된 계정 목록
  sgh add NAME [HOST]      개인 계정 등록 (HOST: github.com 또는 사내 GHE)
  sgh swap NAME            이 SSH 세션만 NAME 프로필로 전환
  sgh swap default         공용 기본 계정으로 즉시 복귀
  sgh bind NAME            현재 SSH 인증키를 NAME에 연결 (다음 로그인부터 자동)
  sgh unbind               현재 SSH 인증키 연결 해제
  sgh status               현재 세션/SSH 바인딩/실제 GitHub 계정 확인
  sgh reauth [NAME]        등록 계정 인증 갱신
  sgh init-default [HOST]  관리자: 기존 공용 gh 인증을 default로 등록

기본 계정에서도 git commit, push, merge, gh pr merge를 사용할 수 있습니다.
개인 계정 인증 실패 시 자동으로 default로 전환되고 원래 명령을 계속합니다.
단, 원래 명령이 실행된 뒤 실패한 경우에는 임의로 다시 실행하지 않습니다.
같은 Linux UID에서는 다른 사람의 인증 파일에도 접근할 수 있습니다.
HELP
}

require_context() {
  [[ -n "${SGH_CONTEXT:-}" && -d "$SGH_CONTEXT" ]] || {
    echo '[sgh] 관리되는 개발 서버 SSH 셸에서 실행하세요. SSH 로그인 훅 설정을 확인하세요.' >&2
    exit 2
  }
}

acquire_lock() {
  local name="$1"
  mkdir -p "$SGH_HOME/locks"
  exec 9>"$SGH_HOME/locks/$name.lock"
  flock -n 9 || {
    printf '[sgh] %s 프로필을 다른 세션에서 설정 중입니다.\n' "$name" >&2
    exit 75
  }
}

fail_to_default() {
  echo '[sgh] 인증/등록이 완료되지 않았습니다. 현재 세션은 default 계정을 사용합니다.' >&2
  sgh_context_set default || true
}

get_new_identity() {
  local alias="$1" login="$2" id="" host="" default_name="" default_email="" name="" email=""
  host="$(sgh_profile_host "$alias")" || return 1
  default_name="$(sgh_gh_command "$alias" api user --jq '.name // .login' 2>/dev/null || true)"
  default_name="${default_name:-$login}"
  # For GHE, use the enterprise account email when exposed by the API;
  # otherwise require the actual corporate email from the user.
  default_email="$(sgh_gh_command "$alias" api user --jq '.email // empty' 2>/dev/null || true)"
  if [[ -z "$default_email" && "$host" == github.com ]]; then
    id="$(sgh_gh_command "$alias" api user --jq .id 2>/dev/null || true)"
    if [[ "$id" =~ ^[0-9]+$ ]]; then default_email="${id}+${login}@users.noreply.github.com"; fi
  fi
  printf '\n[sgh] GitHub 로그인: %s (%s)\n' "$login" "$host"
  if [[ "$host" != github.com ]]; then
    printf '[sgh] GHE 커밋 이메일: 사내 실제 이메일 또는 GHE에 등록된 이메일을 입력하세요.\n'
  else
    printf '[sgh] 커밋 이메일은 본인 GitHub에 연결된 주소를 입력하세요.\n'
  fi
  read -r -p "Git 작성자 이름 [$default_name]: " name || true
  read -r -p "Git 작성자 이메일 [$default_email]: " email || true
  name="${name:-$default_name}"
  email="${email:-$default_email}"
  if [[ -z "$name" || "$name" == *$'\n'* || "$email" != *@* || "$email" == *' '* || "$email" == *$'\n'* ]]; then
    echo '[sgh] 이름 또는 이메일 형식이 올바르지 않습니다.' >&2
    return 1
  fi
  SGH_NEW_NAME="$name" SGH_NEW_EMAIL="$email"
}

cmd_init_default() {
  mkdir -p "$SGH_PROFILES/default" "$(sgh_gh_dir default)"
  acquire_lock default
  local login name email host
  host="$(sgh_host_normalize "${1:-${SGH_GITHUB_HOST:-$(sgh_profile_host default)}}")" || {
    echo '[sgh] 잘못된 GitHub 호스트입니다.' >&2; exit 2;
  }
  SGH_HOST_OVERRIDE_PROFILE=default SGH_HOST_OVERRIDE="$host"
  login="$(sgh_live_login default || true)"
  if [[ -z "$login" ]]; then
    printf '[sgh] 기존 공용 GitHub CLI 인증을 찾지 못했습니다. 로그인합니다.\n'
    if ! sgh_gh_command default auth login --hostname "$host" --git-protocol https --insecure-storage; then
      echo '[sgh] default GitHub 인증 실패. 기존 설정을 보존했습니다.' >&2
      exit 1
    fi
    login="$(sgh_live_login default || true)"
  fi
  [[ -n "$login" ]] || { echo '[sgh] default 로그인 계정을 확인할 수 없습니다.' >&2; exit 1; }
  name="$("$SGH_REAL_GIT" config --file "$(sgh_git_config default)" --get user.name 2>/dev/null || true)"
  email="$("$SGH_REAL_GIT" config --file "$(sgh_git_config default)" --get user.email 2>/dev/null || true)"
  if [[ -z "$name" || -z "$email" ]]; then
    get_new_identity default "$login"
    name="${name:-$SGH_NEW_NAME}" email="${email:-$SGH_NEW_EMAIL}"
    "$SGH_REAL_GIT" config --file "$(sgh_git_config default)" user.name "$name"
    "$SGH_REAL_GIT" config --file "$(sgh_git_config default)" user.email "$email"
  fi
  sgh_write_profile default "$login" "$name" "$email" "$host"
  printf '[sgh] default 준비 완료: GitHub %s (%s) / %s <%s>\n' "$login" "$host" "$name" "$email"
}

cmd_add() {
  require_context
  # Any unexpected error, interruption or failed OAuth must leave this session
  # on the known default; the final registered profile is written last.
  trap 'fail_to_default' EXIT
  local alias="${1:-}" login host
  host="$(sgh_host_normalize "${2:-${SGH_GITHUB_HOST:-$(sgh_profile_host default)}}")" || {
    echo '[sgh] 잘못된 GitHub 호스트입니다. 호스트명 또는 https://HOST/ 형식만 허용합니다.' >&2
    exit 2
  }
  SGH_HOST_OVERRIDE_PROFILE="$alias" SGH_HOST_OVERRIDE="$host"
  sgh_alias_ok "$alias" && [[ "$alias" != default ]] || {
    echo '[sgh] 올바른 개인 프로필 이름을 입력하세요. (default는 sgh init-default)' >&2
    exit 2
  }
  acquire_lock "add-$alias"
  [[ ! -e "$(sgh_profile_file "$alias")" ]] || {
    echo '[sgh] 이미 등록된 이름입니다. sgh swap 또는 sgh reauth를 사용하세요.' >&2
    exit 1
  }
  # A previous interrupted login may have left a partially authenticated gh
  # directory. Clean only this *unregistered* alias while holding its lock.
  rm -rf -- "$(sgh_gh_dir "$alias")"
  mkdir -p "$(sgh_gh_dir "$alias")"
  echo '[sgh] 이 개발 서버의 모든 세션은 같은 Linux UID를 사용하므로 개인 토큰 격리는 제공하지 않습니다.'
  echo "[sgh] $alias 프로필용 GitHub 인증을 시작합니다."
  if ! sgh_gh_command "$alias" auth login --hostname "$host" --git-protocol https --insecure-storage; then
    exit 1
  fi
  login="$(sgh_live_login "$alias" || true)"
  if [[ -z "$login" ]] || ! get_new_identity "$alias" "$login"; then
    exit 1
  fi
  # Commit profile metadata last so an interrupted login is never 'registered'.
  "$SGH_REAL_GIT" config --file "$(sgh_git_config "$alias")" user.name "$SGH_NEW_NAME"
  "$SGH_REAL_GIT" config --file "$(sgh_git_config "$alias")" user.email "$SGH_NEW_EMAIL"
  "$SGH_REAL_GIT" config --file "$(sgh_git_config "$alias")" user.useConfigOnly true
  sgh_write_profile "$alias" "$login" "$SGH_NEW_NAME" "$SGH_NEW_EMAIL" "$host"
  sgh_context_set "$alias"
  trap - EXIT
  unset SGH_HOST_OVERRIDE_PROFILE SGH_HOST_OVERRIDE
  printf '[sgh] 등록 완료: %s → GitHub %s (%s)\n' "$alias" "$login" "$host"
  printf '[sgh] 다음 SSH 접속부터 자동 사용하려면: sgh bind %s\n' "$alias"
}

cmd_swap() {
  require_context
  local alias="${1:-}"
  sgh_alias_ok "$alias" || { echo '[sgh] 사용법: sgh swap <프로필명|default>' >&2; exit 2; }
  if [[ "$alias" == default ]]; then
    sgh_context_set default
    echo '[sgh] 현재 세션: default (commit / push / merge 허용)'
    return 0
  fi
  if sgh_verify_profile "$alias"; then
    sgh_context_set "$alias"
    echo "[sgh] 현재 세션: $alias (GitHub: $SGH_LOGIN)"
  else
    printf '[sgh] %s 인증 실패/프로필 없음. default로 복귀합니다.\n' "$alias" >&2
    sgh_context_set default
    return 1
  fi
}

cmd_list() {
  local profile alias active
  active="$(sgh_current)"
  printf '%-2s %-20s %s\n' '' 'PROFILE' 'GITHUB LOGIN'
  printf '%-2s %-20s %s\n' "$([[ "$active" == default ]] && echo '*' || true)" default \
    "$(sgh_profile_read default && printf '%s' "$SGH_LOGIN" || printf 'uninitialized (sgh init-default)')"
  for profile in "$SGH_PROFILES"/*/profile; do
    [[ -e "$profile" ]] || continue
    alias="$(basename "$(dirname "$profile")")"
    [[ "$alias" == default ]] && continue
    if sgh_profile_read "$alias"; then
      printf '%-2s %-20s %s\n' "$([[ "$active" == "$alias" ]] && echo '*' || true)" "$alias" "$SGH_LOGIN"
    fi
  done
}

cmd_bind() {
  require_context
  local alias="${1:-}" id tmp
  sgh_alias_ok "$alias" || { echo '[sgh] 사용법: sgh bind <프로필명|default>' >&2; exit 2; }
  id="$(sgh_ssh_key_id)" || { echo '[sgh] SSH 공개키 인증이 확인되지 않았습니다 (ExposeAuthInfo 확인).' >&2; exit 1; }
  if [[ "$alias" != default ]] && ! sgh_verify_profile "$alias"; then
    fail_to_default
    echo '[sgh] 인증된 프로필만 SSH 키에 연결할 수 있습니다.' >&2
    exit 1
  fi
  mkdir -p "$SGH_BINDINGS"
  tmp="$(mktemp "$SGH_BINDINGS/.binding.XXXXXX")"
  printf '%s\n' "$alias" > "$tmp"
  mv -f "$tmp" "$SGH_BINDINGS/$id"
  sgh_context_set "$alias"
  printf '[sgh] SSH 키 %s → %s 연결 완료. 다음 로그인부터 자동 선택합니다.\n' "$id" "$alias"
}

cmd_unbind() {
  require_context
  local id
  id="$(sgh_ssh_key_id)" || { echo '[sgh] SSH 인증키를 식별할 수 없습니다.' >&2; exit 1; }
  rm -f "$SGH_BINDINGS/$id"
  sgh_context_set default
  echo '[sgh] SSH 연결 해제. 현재 세션과 다음 접속은 default를 사용합니다.'
}

cmd_reauth() {
  require_context
  trap 'fail_to_default' EXIT
  local alias="${1:-$(sgh_current)}"
  sgh_alias_ok "$alias" || exit 2
  sgh_profile_read "$alias" || { echo '[sgh] 미등록 프로필입니다. sgh add를 사용하세요.' >&2; exit 1; }
  acquire_lock "add-$alias"
  echo "[sgh] $alias 재인증을 시작합니다. 기존 계정: $SGH_LOGIN"
  if ! sgh_gh_command "$alias" auth login --hostname "$(sgh_profile_host "$alias")" --git-protocol https --insecure-storage; then
    exit 1
  fi
  if ! sgh_verify_profile "$alias"; then
    echo '[sgh] 인증된 GitHub 계정이 등록된 프로필과 다릅니다.' >&2
    exit 1
  fi
  sgh_context_set "$alias"
  trap - EXIT
  echo "[sgh] $alias 재인증 완료"
}

cmd_status() {
  local current live id bind="(없음)"
  current="$(sgh_current)"
  printf '현재 세션 프로필 : %s\n' "$current"
  if id="$(sgh_ssh_key_id)"; then
    if [[ -r "$SGH_BINDINGS/$id" ]]; then IFS= read -r bind < "$SGH_BINDINGS/$id" || true; fi
    printf 'SSH key ID       : %s\n' "$id"
  else
    echo 'SSH key ID       : 확인 불가 (기본 계정은 사용 가능)'
  fi
  printf 'SSH 자동 연결    : %s\n' "$bind"
  printf 'GitHub 설정     : %s\n' "$(sgh_gh_dir "$current")"
  printf 'GitHub 호스트   : %s\n' "$(sgh_profile_host "$current")"
  if sgh_profile_read "$current"; then
    printf '기록된 GitHub   : %s\n' "$SGH_LOGIN"
    printf '커밋 작성자     : %s <%s>\n' "$SGH_AUTHOR" "$SGH_EMAIL"
  else
    printf '프로필 메타데이터: 미등록 (sgh init-default 또는 sgh add)\n'
  fi
  live="$(sgh_live_login "$current" || true)"
  printf '실제 GitHub     : %s\n' "${live:-인증 확인 실패}"
  if [[ "$current" == default ]]; then
    echo '동작 모드       : 공용 기본 계정 (Git 변경 허용)'
  elif sgh_verify_profile "$current"; then
    echo '동작 모드       : 개인 계정 정상'
  else
    echo '동작 모드       : 다음 변경 작업 시 default로 자동 복귀'
  fi
}

cmd_auto() {
  require_context
  local id alias
  if ! id="$(sgh_ssh_key_id)"; then
    echo '[sgh] SSH 키 정보가 없어 default 사용 (SSH_USER_AUTH / ExposeAuthInfo 확인)' >&2
    return 0
  fi
  [[ -r "$SGH_BINDINGS/$id" ]] || return 0
  IFS= read -r alias < "$SGH_BINDINGS/$id" || alias=default
  if [[ "$alias" == default ]]; then return 0; fi
  if sgh_alias_ok "$alias" && sgh_verify_profile "$alias"; then
    sgh_context_set "$alias"
    printf '[sgh] SSH 키 기반 자동 선택: %s (%s)\n' "$alias" "$SGH_LOGIN"
  else
    echo "[sgh] SSH 키 연결 프로필($alias) 인증 실패. default로 접속합니다." >&2
  fi
}

case "${1:-status}" in
  init-default) cmd_init_default "${2:-}";;
  add) cmd_add "${2:-}" "${3:-}";;
  swap) cmd_swap "${2:-}";;
  bind) cmd_bind "${2:-}";;
  unbind) cmd_unbind;;
  list|ls) cmd_list;;
  status) cmd_status;;
  reauth) cmd_reauth "${2:-$(sgh_current)}";;
  auto) cmd_auto;;
  -h|--help|help) usage;;
  *) usage >&2; exit 2;;
esac
